APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database
DATABASE_URL=postgres://user:password@host:5432/speakace
ADMIN_EMAILS=admin@example.com
TEACHER_EMAILS=teacher@example.com
EMAIL_FROM=SpeakAce <info@mail.speakace.org>
EMAIL_REPLY_TO=aa.arslan@outlook.com.tr
RESEND_API_KEY=re_...
# Required before any commercial lead or nurture email can be sent.
COMPANY_LEGAL_NAME=
COMPANY_POSTAL_ADDRESS=
# Optional; set only when formally appointed/applicable.
PRIVACY_EU_REPRESENTATIVE=
PRIVACY_DPO_EMAIL=
EMAIL_LIFECYCLE_DAILY_BUDGET=20
# Explicitly set false to pause automated lead-guide retries and nurture sends.
# Lead capture remains available and queues consented requests while paused.
ENABLE_MARKETING_LEAD_NURTURE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_FEEDBACK_MODEL=gpt-4o-mini
OPENAI_FEEDBACK_INPUT_USD_PER_1M=
OPENAI_FEEDBACK_OUTPUT_USD_PER_1M=
OPENAI_TRANSCRIBE_INPUT_USD_PER_1M=
OPENAI_TRANSCRIBE_OUTPUT_USD_PER_1M=

# Analytics
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
ANALYTICS_ID_SALT=replace_with_a_long_random_string
MAINTENANCE_MODE=false

# Payments
LEMON_SQUEEZY_WEBHOOK_SECRET=whsec_...
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
# Merchant variant IDs required for institutional access in webhooks
LEMON_SQUEEZY_INSTITUTION_STARTER_VARIANT_ID=
LEMON_SQUEEZY_INSTITUTION_TEAM_VARIANT_ID=
LEMON_SQUEEZY_INSTITUTION_CAMPUS_VARIANT_ID=
ENABLE_PRACTICE_LIMIT_RECOVERY_EMAILS=false
ENABLE_REVENUE_RECOVERY_EMAILS=false
LEMON_SQUEEZY_STORE_URL=https://speakace.lemonsqueezy.com
GOOGLE_SITE_VERIFICATION=
ADMIN_PANEL_USERNAME=admin
ADMIN_PANEL_PASSWORD=change_me

# Cron / reminders
CRON_SECRET=replace_with_a_long_random_string
UNSUBSCRIBE_SECRET=replace_with_a_separate_long_random_string
MARKETING_LEAD_CONFIRMATION_SECRET=replace_with_another_long_random_string
